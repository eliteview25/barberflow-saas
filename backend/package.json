{
  "name": "barberflow-saas",
  "version": "2.9.1",
  "description": "BarberFlow SaaS - gestão e agendamento para barbearias",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node migrar-banco.js",
    "verify": "node verificar.js",
    "check": "node check.js",
    "audit:config": "node auditar-config.js",
    "test": "node --test test/*.test.js",
    "qa": "npm run check && npm test && npm run audit:security",
    "audit:pilot": "node auditar-piloto.js",
    "maintenance": "node manutencao.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:security": "node auditar-seguranca.js",
    "smoke:security": "node security-smoke.js",
    "backup": "node backup.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  }
}
