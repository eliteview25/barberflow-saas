NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberflow
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

JWT_SECRET=change-me-with-a-long-random-secret
APP_SECRETS_ENCRYPTION_KEY=change-me-with-32-byte-secret-material
BOOKING_OTP_PEPPER=change-me
LOGIN_THROTTLE_SECRET=change-me
CRON_SECRET=change-me
MP_WEBHOOK_TENANT_SECRET=change-me
MP_WEBHOOK_SECRET=change-me
BILLING_WEBHOOK_SECRET=change-me

# OAuth Mercado Pago por barbearia (opcional; preencha o conjunto completo)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_TOKEN_ENCRYPTION_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=BarberFlow <no-reply@example.com>
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=

GOOGLE_MAPS_ROUTES_API_KEY=
ROUTING_FALLBACK_OSM=true

# Vitrine/e-commerce legado preservado, mas desligado no BarberFlow 3.0.
ENABLE_PUBLIC_STORE=false

ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=300000
BACKUP_UPLOAD_URL=
BACKUP_ENCRYPTION_KEY=

PUBLIC_BOOKING_REQUIRE_OTP=true
REQUIRE_TURNSTILE=true
MP_WEBHOOK_MAX_AGE_SECONDS=300
PUBLIC_CHECKOUT_RATE_LIMIT_PER_10_MIN=30
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MIN=30
SENSITIVE_AUTH_RATE_LIMIT_PER_10_MIN=10
PUBLIC_OTP_RATE_LIMIT_PER_30_MIN=10
UPLOAD_RATE_LIMIT_PER_10_MIN=20
EXTERNAL_HTTP_TIMEOUT_MS=10000

# IA opcional do WhatsApp (Premium). Sem chave, o fluxo clássico continua funcionando.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Adaptador fiscal NFS-e. Emissão automática exige provedor/credenciais fiscais compatíveis.
NFSE_API_URL=
NFSE_API_TOKEN=

# Assinaturas SaaS: em produção, configure o Mercado Pago pelo Supermaster.
# Somente para migração legada: permite usar MP_ACCESS_TOKEN/MP_PUBLIC_KEY/MP_WEBHOOK_SECRET do ambiente.
ALLOW_LEGACY_PLATFORM_MP_ENV=false
