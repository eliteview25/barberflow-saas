# ==============================
# BarberFlow SaaS - exemplo V2
# Nunca versione o arquivo .env real.
# ==============================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberflow
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Sessão / criptografia
# Em produção gere valores aleatórios independentes (mínimo 48 caracteres).
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_JWT_SECRET
APP_SECRETS_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS_APP_SECRET
BOOKING_OTP_PEPPER=CHANGE_ME_RANDOM_64_CHARS_BOOKING_OTP
CRON_SECRET=CHANGE_ME_RANDOM_64_CHARS_CRON_SECRET
BILLING_WEBHOOK_SECRET=CHANGE_ME_RANDOM_64_CHARS_BILLING_WEBHOOK

# Bootstrap inicial (somente primeira instalação; depois administre pelo painel)
BOOTSTRAP_BARBERSHOP_NAME=Barbearia Inicial
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD
MASTER_ADMIN_EMAIL=master@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_MASTER_PASSWORD

# Planos BarberFlow
PLAN_STARTER_PRICE=39.90
PLAN_PRO_PRICE=69.90
PLAN_PREMIUM_PRICE=119.90

# Mercado Pago - assinatura BarberFlow
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_MAX_AGE_SECONDS=900

# Mercado Pago Marketplace / conta de cada barbearia
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=http://localhost:3001/api/mercadopago/callback
MP_TOKEN_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS_MP_TOKEN_KEY
MP_MARKETPLACE_FEE_PERCENT=0
# Assina o identificador interno do tenant na notification_url. Use segredo independente.
MP_WEBHOOK_TENANT_SECRET=CHANGE_ME_RANDOM_64_CHARS_MP_TENANT_HMAC

# Agenda pública / antiabuso
BOOKING_HOLD_MINUTES=15
MAX_BOOKING_DAYS=120
PUBLIC_BOOKING_REQUIRE_OTP=true
REQUIRE_TURNSTILE=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_OTP_RATE_LIMIT_PER_30_MIN=5

# Cadastro/verificação por e-mail (Resend)
ALLOW_PUBLIC_REGISTRATION=true
RESEND_API_KEY=
EMAIL_FROM=BarberFlow <no-reply@example.com>

# WhatsApp Cloud API (oficial)
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_APP_SECRET=

# WhatsApp por QR - apenas lembretes; Evolution API deve ficar separada
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ALLOW_INSECURE_EVOLUTION_HTTP=false

# Upload de logo/banner
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_RATE_LIMIT_PER_10_MIN=30

# Webhook opcional para automações externas
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=

# Rede / segurança / filas
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MIN=30
SENSITIVE_AUTH_RATE_LIMIT_PER_10_MIN=20
EXTERNAL_HTTP_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_PROCESSING_STALE_SECONDS=300

# Limite para tentativas com código seguro/reservas públicas
PUBLIC_TOKEN_ATTEMPTS_PER_15_MIN=20
