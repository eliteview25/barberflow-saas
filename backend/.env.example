NODE_ENV=production
PORT=3001
APP_URL=https://seu-dominio.com
RELEASE_VERSION=2.5.2

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Sessão e criptografia (gere valores fortes e únicos em produção)
JWT_SECRET=
APP_SECRETS_ENCRYPTION_KEY=
MP_TOKEN_ENCRYPTION_KEY=
BOOKING_OTP_PEPPER=

# Mercado Pago da plataforma / assinatura BarberFlow
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_TENANT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_MARKETPLACE_FEE_PERCENT=0
MP_WEBHOOK_MAX_AGE_SECONDS=300

# E-mail
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile
REQUIRE_TURNSTILE=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cadastro e booking público
ALLOW_PUBLIC_REGISTRATION=true
PUBLIC_BOOKING_REQUIRE_OTP=true
MAX_BOOKING_DAYS=60
BOOKING_HOLD_MINUTES=15

# WhatsApp / automações (opcionais)
WHATSAPP_ENABLED=false
META_WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ALLOW_INSECURE_EVOLUTION_HTTP=false
CRON_SECRET=

# Uploads Cloudinary (opcional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alertas operacionais (opcional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_COOLDOWN_MS=300000

# Backup lógico (opcional; armazenamento externo recomendado)
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=
BACKUP_UPLOAD_URL=
BACKUP_UPLOAD_TOKEN=
BACKUP_UPLOAD_METHOD=PUT

# Frete da loja (Google Routes opcional; fallback OSM/OSRM)
GOOGLE_MAPS_ROUTES_API_KEY=
ROUTING_FALLBACK_OSM=true

# Suporte exibido ao cliente
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Limites e timeouts
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MIN=30
SENSITIVE_AUTH_RATE_LIMIT_PER_10_MIN=10
SUPPORT_RATE_LIMIT_PER_15_MIN=20
UPLOAD_RATE_LIMIT_PER_10_MIN=20
PUBLIC_OTP_RATE_LIMIT_PER_30_MIN=10
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_TOKEN_ATTEMPTS_PER_15_MIN=20
EXTERNAL_HTTP_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_PROCESSING_STALE_SECONDS=300

# Bootstrap apenas para instalação controlada; deixe vazio normalmente
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_BARBERSHOP_NAME=
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Overrides opcionais de preço anual (o catálogo já possui defaults)
# PLAN_STARTER_ANNUAL_PRICE=599
# PLAN_PRO_ANNUAL_PRICE=1099
# PLAN_PREMIUM_ANNUAL_PRICE=1899
